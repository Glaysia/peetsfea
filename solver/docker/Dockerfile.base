# syntax=docker/dockerfile:1
#
# Forked-Palace CUDA dev/build image — the FEM ENGINE (and the only thing we
# containerize). pfsolver is a Python orchestrator that runs outside Docker and
# invokes this engine, the way pyaedt invokes ansysedt.
#
# This is the HEAVY image (spack builds Palace + deps from source; tens of
# minutes, needs network). Build once via docker/build.sh; develop/patch the
# fork inside it via docker/shell.sh.
#
#   docker build -f docker/Dockerfile.base -t peetsfea-palace:dev ..
#
# Fork baseline:
#   palace@0.16.1 +cuda ~slepc ~sundials cuda_arch=86   (RTX 3070, sm_86)
# The frequency-dependent complex-mu / magnetic-loss patch plus pfsolver
# terminal field-current output and non-rectangular port projected-length support
# produce the PEETSFEA fork version
# 0.16.1pfterm01 from this upstream-equivalent baseline.
FROM docker.io/spack/ubuntu-noble:develop@sha256:2a6981ff541a1040f26c89e23b8c6be089d7afc339b21bf8e4877562f31209f4

SHELL ["/bin/bash", "-lc"]
ENV DEBIAN_FRONTEND=noninteractive

ARG PALACE_SPEC="palace@0.16.1+cuda~slepc~sundials cuda_arch=86"

# Build tools for rebuilding the Palace fork from source in-tree. libreadline is
# declared as a Spack external below so the image does not depend on a fragile
# readline patch mirror during the heavy dependency solve.
RUN apt-get update && apt-get install -y --no-install-recommends \
      cmake ninja-build build-essential git libreadline-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY palace/spack_repo /tmp/palace/spack_repo
COPY palace/extern/patch /tmp/palace/extern/patch

# Build CUDA/MPI/MFEM/HYPRE/PETSc dependencies into a named Spack env using the
# Palace package metadata carried by the fork. M1 then builds the submodule
# source against this dependency closure, so the delivered binary comes from
# solver/palace rather than Spack's package copy.
RUN source /opt/spack/share/spack/setup-env.sh \
 && spack repo add /tmp/palace/spack_repo/local \
 && spack env create palace \
 && printf '%s\n' \
      'packages:' \
      '  readline:' \
      '    externals:' \
      '    - spec: readline@8.2' \
      '      prefix: /usr' \
      '    buildable: false' \
      > /tmp/palace-packages.yaml \
 && spack -e palace config add -f /tmp/palace-packages.yaml \
 && spack -e palace add ${PALACE_SPEC} \
 && spack -e palace concretize -f \
 && spack -e palace install --only dependencies --fail-fast \
 && spack clean -a

COPY palace ./palace
COPY docker/hypre_pool_override.c /tmp/hypre_pool_override.c
COPY docker/palace-wrapper.sh /usr/local/bin/palace

ARG PEETSFEA_PALACE_BASE_VERSION="0.16.1"
ARG PEETSFEA_PALACE_BASE_COMMIT="c13e409f255392b9d78369c386276cf9343c2205"
ARG PEETSFEA_PALACE_FORK_VERSION="0.16.1pfterm01"
ARG PEETSFEA_PALACE_SOURCE_COMMIT="unknown"
ARG PEETSFEA_PALACE_INSTALL_PREFIX="/opt/peetsfea-palace"
ARG PEETSFEA_PALACE_BUILD_JOBS="8"

# Build the in-tree fork source. Third-party dependencies come from the Spack
# closure above; the only delivered Palace binary is compiled from solver/palace.
RUN source /opt/spack/share/spack/setup-env.sh \
 && spack env activate palace \
 && spack_view="/opt/spack/var/spack/environments/palace/.spack-env/view" \
 && arpack_prefix="$(spack -e palace location -i arpack-ng)" \
 && cuda_prefix="$(spack -e palace location -i cuda)" \
 && eigen_prefix="$(spack -e palace location -i eigen)" \
 && gslib_prefix="$(spack -e palace location -i gslib)" \
 && hypre_prefix="$(spack -e palace location -i hypre)" \
 && libceed_prefix="$(spack -e palace location -i libceed)" \
 && metis_prefix="$(spack -e palace location -i metis)" \
 && mfem_prefix="$(spack -e palace location -i mfem)" \
 && parmetis_prefix="$(spack -e palace location -i parmetis)" \
 && pkgconf_prefix="$(spack -e palace location -i pkgconf)" \
 && superlu_prefix="$(spack -e palace location -i superlu-dist)" \
 && test -x "${pkgconf_prefix}/bin/pkg-config" \
 && test -f "${cuda_prefix}/lib64/stubs/libcuda.so" \
 && ln -sf "${cuda_prefix}/lib64/stubs/libcuda.so" "${cuda_prefix}/lib64/stubs/libcuda.so.1" \
 && export LIBRARY_PATH="${cuda_prefix}/lib64/stubs:${LIBRARY_PATH:-}" \
 && export LD_LIBRARY_PATH="${cuda_prefix}/lib64/stubs:${LD_LIBRARY_PATH:-}" \
 && export PKG_CONFIG_PATH="${libceed_prefix}/lib/pkgconfig:${libceed_prefix}/lib64/pkgconfig:${PKG_CONFIG_PATH:-}" \
 && cmake -S /src/palace/palace -B /build/peetsfea-palace -G Ninja \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_PREFIX=${PEETSFEA_PALACE_INSTALL_PREFIX} \
      -DCMAKE_PREFIX_PATH="${spack_view};${eigen_prefix}" \
      -DCMAKE_EXE_LINKER_FLAGS="-Wl,-rpath-link,${cuda_prefix}/lib64/stubs" \
      -DEigen3_DIR="${eigen_prefix}/share/eigen3/cmake" \
      -DMFEM_DIR="${mfem_prefix}" \
      -DHYPRE_DIR="${hypre_prefix}" \
      -DGSLIB_DIR="${gslib_prefix}" \
      -DSUPERLU_DIST_DIR="${superlu_prefix}" \
      -DMETIS_DIR="${metis_prefix}" \
      -DPARMETIS_DIR="${parmetis_prefix}" \
      -DARPACK_DIR="${arpack_prefix}" \
      -DPKG_CONFIG_EXECUTABLE="${pkgconf_prefix}/bin/pkg-config" \
      -DPALACE_WITH_CUDA=ON \
      -DCMAKE_CUDA_ARCHITECTURES=86 \
      -DCMAKE_CUDA_HOST_COMPILER=/usr/bin/c++ \
      -DPALACE_WITH_SLEPC=OFF \
      -DPALACE_WITH_ARPACK=ON \
      -DPALACE_WITH_SUNDIALS=OFF \
 && cmake --build /build/peetsfea-palace --parallel ${PEETSFEA_PALACE_BUILD_JOBS} \
 && cmake --install /build/peetsfea-palace \
 && mkdir -p ${PEETSFEA_PALACE_INSTALL_PREFIX}/lib \
 && mpicc -shared -fPIC -O2 /tmp/hypre_pool_override.c \
      -I"${hypre_prefix}/include" -L"${hypre_prefix}/lib" -lHYPRE \
      -ldl -Wl,-rpath,"${hypre_prefix}/lib" \
      -o ${PEETSFEA_PALACE_INSTALL_PREFIX}/lib/libhypre_pool_override.so \
 && chmod +x /usr/local/bin/palace \
 && printf '%s\n' \
      "base_version=${PEETSFEA_PALACE_BASE_VERSION}" \
      "base_commit=${PEETSFEA_PALACE_BASE_COMMIT}" \
      "fork_version=${PEETSFEA_PALACE_FORK_VERSION}" \
      "source_commit=${PEETSFEA_PALACE_SOURCE_COMMIT}" \
      "source_tree=solver/palace submodule" \
      "cuda_arch=86" \
      "palace_with_cuda=ON" \
      "palace_with_slepc=OFF" \
      "palace_with_arpack=ON" \
      "palace_with_sundials=OFF" \
      "hypre_pool_override=${PEETSFEA_PALACE_INSTALL_PREFIX}/lib/libhypre_pool_override.so" \
      > ${PEETSFEA_PALACE_INSTALL_PREFIX}/PEETSFEA_BUILD_INFO

# Activate the spack env (palace, cuda, mpi on PATH) for every non-login shell.
RUN printf '%s\n' \
      'source /opt/spack/share/spack/setup-env.sh' \
      'spack env activate palace' \
      'spack load cuda mpi 2>/dev/null || true' \
      'export PEETSFEA_PALACE_HOME=/opt/peetsfea-palace' \
      'export PEETSFEA_HYPRE_POOL_OVERRIDE=/opt/peetsfea-palace/lib/libhypre_pool_override.so' \
      'export LD_LIBRARY_PATH=/opt/spack/var/spack/environments/palace/.spack-env/view/lib:/opt/spack/var/spack/environments/palace/.spack-env/view/lib64:${LD_LIBRARY_PATH:-}' \
      'export PATH=/usr/local/bin:/opt/peetsfea-palace/bin:$PATH' \
      > /etc/profile.d/zz-palace-env.sh \
    && chmod +x /etc/profile.d/zz-palace-env.sh

ENV PEETSFEA_PALACE_HOME=/opt/peetsfea-palace \
    PEETSFEA_HYPRE_POOL_OVERRIDE=/opt/peetsfea-palace/lib/libhypre_pool_override.so \
    LD_LIBRARY_PATH=/opt/spack/var/spack/environments/palace/.spack-env/view/lib:/opt/spack/var/spack/environments/palace/.spack-env/view/lib64 \
    PATH=/usr/local/bin:/opt/peetsfea-palace/bin:/opt/spack/var/spack/environments/palace/.spack-env/view/bin:$PATH

# phase0 finding: default HYPRE/Umpire CUDA pools overshoot small-VRAM cards and
# abort with cudaMalloc OOM. The pfsolver orchestrator sets VRAM-fitted pool
# sizes before invoking palace; this label records the knob so it is never lost.
LABEL org.peetsfea.hypre_pool_override="rank-aware adaptive via PEETSFEA_HYPRE_*_POOL_BYTES"

ENTRYPOINT []
CMD ["/bin/bash", "-l"]
