{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "install-dev-editable",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python -m uv pip install -e \".[dev]\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "clean-run-aedt",
      "type": "shell",
      "command": "mkdir -p ${workspaceFolder}/run/aedt && find ${workspaceFolder}/run/aedt -mindepth 1 -maxdepth 1 -exec rm -rf {} +",
      "problemMatcher": []
    },
    {
      "label": "clean-run-toml",
      "type": "shell",
      "command": "mkdir -p ${workspaceFolder}/run/toml && find ${workspaceFolder}/run/toml -mindepth 1 -maxdepth 1 -exec rm -rf {} +",
      "problemMatcher": []
    },
    {
      "label": "prepare-sample-debug",
      "dependsOrder": "sequence",
      "dependsOn": [
        "install-dev-editable",
        "clean-run-toml"
      ],
      "problemMatcher": []
    },
    {
      "label": "prepare-build-debug",
      "dependsOrder": "sequence",
      "dependsOn": [
        "install-dev-editable",
        "clean-run-aedt"
      ],
      "problemMatcher": []
    },
    {
      "label": "prepare-sample-build-debug",
      "dependsOrder": "sequence",
      "dependsOn": [
        "install-dev-editable",
        "clean-run-toml",
        "clean-run-aedt"
      ],
      "problemMatcher": []
    }
  ]
}
