{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "clean-run",
      "type": "shell",
      "command": "mkdir -p ${workspaceFolder}/run && find ${workspaceFolder}/run -mindepth 1 -maxdepth 1 -exec rm -rf {} +",
      "problemMatcher": []
    },
    {
      "label": "install-peetsfea-all",
      "type": "shell",
      "command": "uv pip install --python ${workspaceFolder}/.venv/bin/python -e \".[all]\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "prepare-minimal-step-debug",
      "dependsOrder": "sequence",
      "dependsOn": [
        "clean-run",
        "install-peetsfea-all"
      ],
      "problemMatcher": []
    }
  ]
}
