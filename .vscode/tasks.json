{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "clean-run",
      "type": "shell",
      "command": "mkdir -p ${workspaceFolder}/run && find ${workspaceFolder}/run -mindepth 1 -maxdepth 1 -exec rm -rf {} +",
      "problemMatcher": []
    },
    {
      "label": "run-type2-sample",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python ../entry/sample.py",
      "options": {
        "cwd": "${workspaceFolder}/run"
      },
      "dependsOrder": "sequence",
      "dependsOn": [
        "clean-run"
      ],
      "problemMatcher": []
    }
  ]
}
